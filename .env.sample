AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-portops-poc-xxxxx
AZURE_LOCATION=swedencentral
FOUNDRY_ACCOUNT_NAME=aif-portops-xxxxx
FOUNDRY_ENDPOINT=https://aif-portops-xxxxx.cognitiveservices.azure.com/
PROJECT_ENDPOINT_OPS=https://aif-portops-xxxxx.services.ai.azure.com/api/projects/ops
PROJECT_ENDPOINT_IT=https://aif-portops-xxxxx.services.ai.azure.com/api/projects/it
PROJECT_ENDPOINT_CS=https://aif-portops-xxxxx.services.ai.azure.com/api/projects/cs
APIM_NAME=apim-portops-xxxxx
APIM_GATEWAY_URL=https://apim-portops-xxxxx.azure-api.net
APIM_KEY_OPS=<set-by-deploy.ps1>
APIM_KEY_IT=<set-by-deploy.ps1>
APIM_KEY_CS=<set-by-deploy.ps1>
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Written by scripts/deploy-workbook.ps1 (used by the UI to link to the workbook)
WORKBOOK_ID=
MCP_URL=
# MCP through the APIM gateway (written by scripts/deploy-mcp.ps1): MCP_URL is the direct Container App endpoint and needs the backend key
MCP_GATEWAY_URL=https://apim-portops-xxxxx.azure-api.net/mcp
MCP_KEY_OPS=<set-by-deploy-mcp.ps1>
MCP_KEY_IT=<set-by-deploy-mcp.ps1>
MCP_KEY_CS=<set-by-deploy-mcp.ps1>
MODEL_SMALL=gpt-4.1-mini
MODEL_LARGE=gpt-4.1

# Identity-based limits (written by scripts/setup-entra.ps1; test users are synthetic demo-tenant users)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_APP_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://portops-ai-gateway
ENTRA_CLIENT_APP_ID=00000000-0000-0000-0000-000000000000
PORTOPS_TESTUSER_OPS_UPN=portops-ops-user@<tenant>.onmicrosoft.com
PORTOPS_TESTUSER_OPS_PASSWORD=<set-by-setup-entra.ps1>
PORTOPS_TESTUSER_IT_UPN=portops-it-user@<tenant>.onmicrosoft.com
PORTOPS_TESTUSER_IT_PASSWORD=<set-by-setup-entra.ps1>
PORTOPS_TESTUSER_CS_UPN=portops-cs-user@<tenant>.onmicrosoft.com
PORTOPS_TESTUSER_CS_PASSWORD=<set-by-setup-entra.ps1>
